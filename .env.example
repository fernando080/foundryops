# Demo-safe defaults. Copy to .env.local for local overrides; never commit real secrets.
LLM_PROVIDER=stub
FOUNDRY_MODE=mock
FOUNDRYOPS_DB_PATH=./data/foundryops.db
FOUNDRY_WEBHOOK_SECRET=demo-secret

# Optional, only required for the (stretch) Gemini adapter / live Foundry mode.
# Leave unset for the mock/stub demo path.
GEMINI_API_KEY=
FOUNDRY_TOKEN=
